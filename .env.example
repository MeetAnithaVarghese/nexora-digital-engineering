# Nexora Digital Engineering Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database Persistence
DATABASE_FILE=./nexora.db

# Authentication & Session Security
SESSION_SECRET=super_secret_cryptographic_key_change_me_in_production_min_32_chars
SESSION_TTL_HOURS=24

# Initial Admin Bootstrap (Used during seed / migration)
INITIAL_ADMIN_EMAIL=admin@nexora.example.com
INITIAL_ADMIN_PASSWORD=NexoraAdminSecure2026!

# Notification & Email (Mocked in development, SMTP in staging/production)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_password
NOTIFICATION_RECIPIENT_EMAIL=leads@nexora.example.com

# Analytics & Observability
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_mock_posthog_key_12345
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
